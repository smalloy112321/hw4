# Copy this file to .env (in the hw4 folder) and fill in your own values.
# Never commit .env.

# Portkey API key for the chatbot's model calls (https://portkey.ai).
PORTKEY_API_KEY=your-portkey-api-key-here

# Long random string that signs login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: override the model (default gpt-6-astra).
# OPENAI_MODEL=gpt-6-astra
